"help.helper.title" = "Izinkan Helper";
"help.helper.desc" = "/etc/hosts dimiliki oleh root, jadi helper kecil menyimpan perubahan Anda. Izinkan sekali di Pengaturan Sistem → Umum → Item Login & Ekstensi (atau klik Buka Item Login… di samping status). Titik hijau berarti helper siap.";
"help.add.title" = "Tambah Entri";
"help.add.desc" = "Klik Tambah (⌘N), masukkan alamat IP dan satu atau beberapa nama host yang dipisahkan spasi, mis. 127.0.0.1 api.test. ✨ Buat Komentar menyarankan komentar — hanya entri itu yang dikirim ke AI.";
"help.toggle.title" = "Aktifkan / Nonaktifkan";
"help.toggle.desc" = "Klik lingkaran pada baris untuk menonaktifkan entri tanpa menghapusnya. Entri disimpan sebagai # 127.0.0.1 api.test. Klik dua kali baris atau ✎ untuk mengedit.";
"help.search.title" = "Cari";
"help.search.desc" = "⌘F memfilter berdasarkan IP atau nama host. Hanya entri yang cocok yang ditampilkan saat Anda mencari.";
"help.sections.title" = "Bagian";
"help.sections.desc" = "Klik Bagian untuk menambahkan pemisah baris kosong, lalu ketik judulnya (Return menyimpannya sebagai # judul). Kosongkan judul untuk menghapusnya.";
"help.reorder.title" = "Ubah Urutan";
"help.reorder.desc" = "Seret baris untuk mengubah urutan — bagian berpindah bersama judulnya. ⌘-klik atau ⇧-klik untuk memilih beberapa baris (bagian dan entri) lalu seret bersamaan. Seret dinonaktifkan saat mencari; baris sistem tetap di tempatnya.";
"help.system.title" = "Entri Sistem";
"help.system.desc" = "localhost dan broadcasthost sudah ada di macOS dan dikunci 🔒 agar sistem tetap berfungsi. Helper menolak file apa pun tanpa 127.0.0.1 localhost.";
"help.import.title" = "Impor / Ekspor";
"help.import.desc" = "Impor file hosts apa pun — Gabungkan hanya menambahkan entri baru, Ganti menukar entri Anda (entri sistem Mac ini tetap ada). Ekspor menyimpan persis apa yang ditampilkan Pratinjau Mentah.";
"help.restore.title" = "Riwayat";
"help.restore.desc" = "Setiap penyimpanan menjadi satu langkah di Riwayat (30 terakhir, terbaru di atas), dinamai sesuai perubahannya. Klik dua kali sebuah langkah atau gunakan tombol ↩ untuk kembali — kembali juga menjadi langkah baru, jadi tidak ada yang hilang. Sematkan versi untuk menyimpannya; versi saat app dibuka disematkan otomatis. Klik ikon tempat sampah pada sebuah langkah untuk menghapusnya dari daftar.";
"help.preview.title" = "Pratinjau Mentah";
"help.preview.desc" = "Lihat persis apa yang akan ditulis ke /etc/hosts, termasuk baris komentar Anda. Salin dengan ⇧⌘C.";
"help.ai.title" = "Agen AI";
"help.ai.desc" = "Tanyakan tentang entri Anda atau ketuk Pesan Cepat. Pertanyaan menyertakan /etc/hosts Anda; Apple Foundation Models dan Ollama menjaganya tetap di Mac ini. Klik nama model untuk berganti model, ⚙ untuk mengubah penyedia.";
