"help.sections.title" = "Phần";
"help.sections.desc" = "Nhấp Phần để thêm một dòng trống ngăn cách, rồi nhập tiêu đề (Return sẽ lưu dưới dạng # tiêu đề). Xóa tiêu đề để gỡ bỏ phần.";
"help.reorder.title" = "Sắp xếp lại";
"help.reorder.desc" = "Kéo các hàng để sắp xếp lại — một phần di chuyển cùng với tiêu đề của nó. Nhấn ⌘ hoặc ⇧ rồi nhấp để chọn nhiều hàng (phần và mục) và kéo chúng cùng nhau. Không thể kéo khi đang tìm kiếm; các hàng hệ thống giữ nguyên vị trí.";
"help.system.title" = "Mục hệ thống";
"help.system.desc" = "localhost và broadcasthost đi kèm macOS và được khóa 🔒 để hệ thống tiếp tục hoạt động. Trình hỗ trợ từ chối mọi tệp không có 127.0.0.1 localhost.";
"help.import.title" = "Nhập / Xuất";
"help.import.desc" = "Nhập bất kỳ tệp hosts nào — Hợp nhất chỉ thêm các mục mới, Thay thế sẽ đổi mục của bạn (mục hệ thống của Mac này được giữ nguyên). Xuất lưu đúng nội dung mà Xem trước bản gốc hiển thị.";
"help.restore.title" = "Lịch sử";
"help.restore.desc" = "Mỗi lần lưu là một bước trong Lịch sử (30 bước gần nhất, mới nhất trước), được đặt tên theo nội dung thay đổi. Nhấp đúp vào một bước hoặc dùng nút ↩ của nó để quay lại — quay lại cũng là một bước mới, nên không có gì bị mất. Ghim một phiên bản để giữ lại; phiên bản lúc ứng dụng mở được ghim sẵn cho bạn. Nhấp thùng rác của một bước để xóa nó khỏi danh sách.";
"help.preview.title" = "Xem trước bản gốc";
"help.preview.desc" = "Xem chính xác nội dung sẽ được ghi vào /etc/hosts, bao gồm các dòng chú thích của bạn. Sao chép bằng ⇧⌘C.";
"help.ai.title" = "Trợ lý AI";
"help.ai.desc" = "Hỏi về các mục của bạn hoặc chạm vào một Tin nhắn nhanh. Câu hỏi bao gồm /etc/hosts của bạn; Apple Foundation Models và Ollama giữ dữ liệu trên Mac này. Nhấp tên mô hình để chuyển mô hình, ⚙ để đổi nhà cung cấp.";
