"help.helper.title" = "Payagan ang Helper";
"help.helper.desc" = "Pag-aari ng root ang /etc/hosts, kaya isang maliit na helper ang nagse-save ng iyong mga pagbabago. Payagan ito nang isang beses sa System Settings → General → Login Items & Extensions (o i-click ang Buksan ang Login Items… sa tabi ng status). Ang berdeng tuldok ay nangangahulugang handa na ito.";
"help.add.title" = "Magdagdag ng Entry";
"help.add.desc" = "I-click ang Idagdag (⌘N), maglagay ng IP address at isa o higit pang hostname na pinaghiwalay ng espasyo, hal. 127.0.0.1 api.test. Ang ✨ Gumawa ng Komento ay nagmumungkahi ng komento — ang entry lang na iyon ang ipapadala sa AI.";
"help.toggle.title" = "I-enable / I-disable";
"help.toggle.desc" = "I-click ang bilog sa isang row para i-disable ang isang entry nang hindi ito binubura. Nase-save ito bilang # 127.0.0.1 api.test. I-double-click ang row o ang ✎ para mag-edit.";
"help.search.title" = "Maghanap";
"help.search.desc" = "Sinasala ng ⌘F ayon sa IP o hostname. Mga tumutugmang entry lang ang ipinapakita habang naghahanap.";
"help.sections.title" = "Mga Seksyon";
"help.sections.desc" = "I-click ang Seksyon para magdagdag ng blank-line break, pagkatapos ay i-type ang heading nito (sine-save ito ng Return bilang # heading). Burahin ang heading para alisin ito.";
"help.reorder.title" = "Ayusin ang Pagkakasunod";
"help.reorder.desc" = "I-drag ang mga row para ayusin ang pagkakasunod — sabay na gumagalaw ang seksyon at ang heading nito. ⌘-click o ⇧-click para pumili ng ilang row (mga seksyon at entry) at i-drag nang sabay. Naka-off ang pag-drag habang naghahanap; hindi gumagalaw ang mga system row.";
"help.system.title" = "Mga System Entry";
"help.system.desc" = "Ang localhost at broadcasthost ay kasama ng macOS at naka-lock 🔒 para patuloy na gumana ang system. Tinatanggihan ng helper ang anumang file na walang 127.0.0.1 localhost.";
"help.import.title" = "I-import / I-export";
"help.import.desc" = "Mag-import ng anumang hosts file — Ang Pagsamahin ay nagdaragdag ng mga bagong entry lang, ang Palitan ay papalit sa iyo (mananatili ang mga system entry ng Mac na ito). Sine-save ng I-export nang eksakto ang ipinapakita ng I-preview ang Raw.";
"help.restore.title" = "History";
"help.restore.desc" = "Bawat save ay isang hakbang sa History (ang huling 30, pinakabago muna), na ipinangalan ayon sa nabago. I-double-click ang isang hakbang o gamitin ang ↩ button nito para bumalik — ang pagbalik ay bagong hakbang din, kaya walang mawawala. I-pin ang isang bersyon para itago ito; ang bersyon noong binuksan ang app ay awtomatikong naka-pin. I-click ang basurahan ng isang hakbang para alisin ito sa listahan.";
"help.preview.title" = "I-preview ang Raw";
"help.preview.desc" = "Tingnan nang eksakto kung ano ang isusulat sa /etc/hosts, kasama ang iyong mga linya ng komento. Kopyahin gamit ang ⇧⌘C.";
"help.ai.title" = "AI Agent";
"help.ai.desc" = "Magtanong tungkol sa iyong mga entry o pumili ng Quick Message. Kasama sa mga tanong ang iyong /etc/hosts; pinananatili ito sa Mac na ito ng Apple Foundation Models at Ollama. I-click ang pangalan ng model para magpalit ng model, ⚙ para magpalit ng provider.";
"err.notInstalled" = "Hindi naka-install ang helper. Aprubahan ito sa System Settings → General → Login Items.";
